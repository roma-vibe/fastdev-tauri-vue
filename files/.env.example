# Application name: window title, macOS menu bar, Dock, the .app/.dmg name and the UI.
# The single source of the name: scripts/tauri.ts passes it to Tauri, vite.config.ts to the UI.
APP_NAME='My App'

# Machine-friendly name: the Rust package and binary (src-tauri/Cargo.toml). Dev builds keep their
# WebView data in ~/Library/WebKit/<APP_SLUG> and ~/Library/Caches/<APP_SLUG>.
APP_SLUG=my-app

# macOS bundle identifier (reverse domain). Release builds keep their data in
# ~/Library/Application Support/<APP_IDENTIFIER>. Set your own before the first release.
APP_IDENTIFIER=com.example.my-app

# Vite dev server that the dev window loads (npm run dev).
WEB_PORT=1420
