{
  "name": "app",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node scripts/tauri.ts dev",
    "build": "node scripts/tauri.ts build",
    "tauri": "node scripts/tauri.ts",
    "dev:web": "vite",
    "build:web": "vue-tsc --build && vite build",
    "test": "npm run test:web && npm run test:rust",
    "test:web": "vitest run",
    "test:rust": "cargo test --manifest-path src-tauri/Cargo.toml --locked",
    "lint": "npm run lint:web && npm run lint:rust",
    "lint:web": "eslint . --max-warnings 0",
    "lint:rust": "cargo clippy --manifest-path src-tauri/Cargo.toml --all-targets --locked -- -D warnings",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write . && cargo fmt --manifest-path src-tauri/Cargo.toml",
    "format:check": "prettier --check . && cargo fmt --manifest-path src-tauri/Cargo.toml --check",
    "typecheck": "vue-tsc --build",
    "check": "npm run lint && npm run format:check && npm run typecheck && npm test"
  },
  "dependencies": {
    "@tauri-apps/api": "^2.12.0",
    "pinia": "^4.0.3",
    "vue": "^3.5.43",
    "vue-router": "^5.3.1"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@tailwindcss/vite": "^4.3.3",
    "@tauri-apps/cli": "^2.12.0",
    "@types/node": "^24.19.0",
    "@vitejs/plugin-vue": "^6.0.9",
    "@vue/test-utils": "^2.5.1",
    "eslint": "^10.11.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-vue": "^10.11.1",
    "globals": "^17.12.0",
    "happy-dom": "^20.14.5",
    "prettier": "^3.9.9",
    "tailwindcss": "^4.3.3",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.71.0",
    "vite": "^8.3.1",
    "vitest": "^5.0.3",
    "vue-tsc": "^3.3.11"
  },
  "engines": {
    "node": ">=24"
  },
  "allowScripts": {
    "fsevents": false
  }
}
